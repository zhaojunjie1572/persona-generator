:8080 {
    # Enable compression
    encode gzip zstd

    # Set headers for security and performance
    header {
        # Security headers
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        
        # CORS headers
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, anthropic-version"
        Access-Control-Max-Age "3600"
        
        # Cache static assets
        Cache-Control "public, max-age=31536000, immutable"
    }

    # Handle preflight OPTIONS requests
    @options {
        method OPTIONS
    }
    handle @options {
        header {
            Access-Control-Allow-Origin "*"
            Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization, anthropic-version"
            Access-Control-Max-Age "3600"
        }
        respond "" 204
    }

    # Proxy MiniMax API requests
    handle /minimax-api/* {
        uri strip_prefix /minimax-api
        reverse_proxy https://api.minimaxi.com {
            header_up Host api.minimaxi.com
            header_up X-Forwarded-Host {host}
        }
    }

    # Root directory
    root * .
    
    # Enable file server with clean URLs
    file_server {
        hide .git .env
    }

    # Try files in order: exact path -> index.html
    try_files {path} {path}/ /index.html
    
    # Log configuration
    log {
        output stdout
        format json
    }

    # Health check endpoint
    handle /health {
        respond "OK" 200
    }
}
